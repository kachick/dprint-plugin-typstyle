{
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {
    "tags": {
      "nix": "nix",
      "sh": "sh",
      "bash": "bash",
      "zsh": "zsh",
      "envrc": "bash",
      "shell": "sh",
      "shell-script": "sh"
    }
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false
  },
  "toml": {
  },
  "excludes": ["tests"],
  "plugins": [
    "npm:@dprint/json@0.25.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@kachick/dprint-plugin-nix@0.1.1",
    "npm:@kachick/dprint-plugin-sh@0.1.2"
  ]
}
